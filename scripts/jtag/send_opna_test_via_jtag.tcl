connect
targets -set -filter {name =~ "ARM*#0"}

set CODE_ADDR 0x00200000
set code {}

lappend code 0xE3000000   ;# MOVW R0, #0x0000
lappend code 0xE34043C0   ;# MOVT R0, #0x43C0  → R0=0x43C00000

foreach {reg data} {
    0x30 0x01  0x40 0x10  0x50 0x1F  0x60 0x00  0x70 0x00  0x80 0x0F
    0x38 0x01  0x48 0x7F  0x58 0x1F  0x68 0x00  0x78 0x00  0x88 0x0F
    0x34 0x01  0x44 0x7F  0x54 0x1F  0x64 0x00  0x74 0x00  0x84 0x0F
    0x3C 0x01  0x4C 0x7F  0x5C 0x1F  0x6C 0x00  0x7C 0x00  0x8C 0x0F
    0xA0 0x57  0xA4 0x24  0xB0 0x00  0xB4 0xC0
    0x28 0xF0
} {
    lappend code [expr {0xE3A01000 | $reg}]
    lappend code 0xE5C10000
    lappend code [expr {0xE3A01000 | $data}]
    lappend code 0xE5C10001
}
lappend code 0xEAFFFFFE   ;# B . (infinite loop)

puts "Writing [llength $code] instructions..."
set addr $CODE_ADDR
foreach instr $code {
    mwr $addr $instr 4
    incr addr 4
}

puts "Setting PC=0x[format %X $CODE_ADDR], running..."
rwr pc $CODE_ADDR
con
puts "Done! Listen for FM tone. led[3] should be ON."
